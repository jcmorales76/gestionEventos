# Copia este archivo como .env y completa los valores.
# En cPanel estas variables se definen en "Setup Node.js App" (Environment variables),
# no hace falta subir el .env.

# Puerto: en local usa 5000. En cPanel/Passenger NO lo definas (lo asigna el hosting).
PORT=5000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eventflow_db

# Correo (SMTP de cPanel). Si no se define, los correos se omiten sin error.
# Crea una cuenta de correo en cPanel (ej. noreply@eventosfpcmac.com) y usa sus datos.
SMTP_HOST=mail.eventosfpcmac.com
SMTP_PORT=465
SMTP_USER=noreply@eventosfpcmac.com
SMTP_PASS=la_contraseña_de_esa_cuenta
SMTP_FROM=noreply@eventosfpcmac.com

# URL pública de la app (para el botón "Iniciar sesión" del correo)
APP_URL=https://eventos.eventosfpcmac.com
